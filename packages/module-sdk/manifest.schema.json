{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/agentmuster/muster/packages/module-sdk/manifest.schema.json",
  "title": "Muster module manifest (muster-module.json)",
  "type": "object",
  "required": ["id", "name", "version", "apiVersion", "entry", "settings"],
  "properties": {
    "$schema": {"type": "string"},
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,62}$", "description": "Stable id; settings and secrets are stored under it."},
    "name": {"type": "string"},
    "description": {"type": "string"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+([-+][0-9A-Za-z.-]+)?$"},
    "apiVersion": {"const": 1},
    "entry": {"type": "string", "description": "The module's code, relative to this file, such as ./index.ts."},
    "network": {"type": "array", "items": {"type": "string"}, "description": "Hosts the module may contact, such as api.bitbucket.org."},
    "connectors": {"type": "array", "items": {"enum": ["composio"]}},
    "settings": {"type": "array", "items": {"$ref": "#/$defs/field"}},
    "actions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"},
          "title": {"type": "string"},
          "description": {"type": "string"},
          "confirm": {"enum": ["always", "never"], "description": "Anything other than never needs a preview and the owner's confirmation."},
          "policy": {"type": "string", "description": "A check Muster runs before the preview and the run, such as reviewed-pr."}
        }
      }
    },
    "feeds": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"},
          "title": {"type": "string"},
          "every": {"type": "number", "minimum": 1, "description": "Minutes between checks."}
        }
      }
    },
    "tools": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "description", "parameters"],
        "properties": {
          "name": {"type": "string", "pattern": "^[a-z][a-z0-9_]{2,48}$"},
          "description": {"type": "string"},
          "parameters": {"type": "object", "properties": {"type": {"const": "object"}}, "required": ["type"]}
        }
      }
    },
    "providers": {
      "type": "object",
      "properties": {
        "pullRequests": {
          "type": "object",
          "required": ["links", "mergeAction"],
          "properties": {
            "links": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": ["host", "path"],
                "properties": {
                  "host": {"type": "string", "description": "Exact host, such as bitbucket.org."},
                  "path": {"type": "string", "description": "Path template with {placeholders} and one {number}, such as /{owner}/{repo}/pull-requests/{number}."}
                }
              }
            },
            "mergeAction": {"type": "string", "description": "The action that merges; it must declare policy reviewed-pr."}
          }
        }
      }
    }
  },
  "$defs": {
    "field": {
      "type": "object",
      "required": ["key", "label", "type"],
      "properties": {
        "key": {"type": "string", "pattern": "^[A-Za-z0-9_:.-]{1,80}$"},
        "label": {"type": "string"},
        "type": {"enum": ["string", "secret", "text", "number", "select"]},
        "description": {"type": "string"},
        "default": {"type": ["string", "number"]},
        "required": {"type": "boolean"},
        "options": {"type": "array", "items": {"type": "object", "required": ["value"], "properties": {"value": {"type": "string"}, "label": {"type": "string"}}}},
        "showWhen": {"type": "object", "additionalProperties": {"type": "array", "items": {"type": "string"}}},
        "link": {"type": "object", "required": ["url", "label"], "properties": {"url": {"type": "string", "pattern": "^https://"}, "label": {"type": "string"}}}
      }
    }
  }
}
