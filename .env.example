# Copy to .env and change what you need. Everything here is optional; the defaults are shown.

# Muster only listens on loopback. List the exact Host headers it accepts, including the port.
PORT=47831
MUSTER_ALLOWED_HOSTS=127.0.0.1:47831,localhost:47831
# Hostnames for remote access can instead go in $MUSTER_DATA_DIR/allowed-hosts (one per line).
# That file is re-read when it changes, so adding a host needs no restart.

# Set to 1 only when Muster is reachable solely through Cloudflare. Sign-in throttling then counts
# each CF-Connecting-IP separately instead of treating the whole tunnel as one client.
MUSTER_TRUST_CF_CONNECTING_IP=0

# Folders a new thread may start in, comma-separated, no ~. Defaults to your home folder.
# MUSTER_WORKSPACE_ROOTS=/path/to/projects,/path/to/other-projects

# Private data: threads, the session index, sign-in files. Defaults to ~/.local/share/muster.
# MUSTER_DATA_DIR=

# The Pi and Python executables, if they are not on PATH.
# PI_BIN=pi
# PYTHON=python3

# BrowserOS's local DevTools endpoint, for browser takeover.
# BROWSEROS_CDP_URL=http://127.0.0.1:9110

# Set to 1 to keep the in-browser terminal off, whatever its setting in the app.
# MUSTER_TERMINAL_DISABLED=1

# Optional Cloudflare Access sign-in. With all three set, a request carrying a valid
# Cf-Access-Jwt-Assertion for this application and one of these emails needs no app password.
MUSTER_ACCESS_TEAM=
MUSTER_ACCESS_AUD=
MUSTER_ACCESS_EMAILS=
